# Copy this file to .env and fill in your own values. NEVER commit .env (it is git-ignored).
# Every secret below is intentionally blank.

# ---- Credit Report source -------------------------------------------------------------------
# The UI workflow is the only source: Member List -> Search IC -> Apply -> Actions -> Credit
# report -> popup -> extract, in a dedicated headless browser profile (data/kw_profile_workflow).
# It reuses the session of your normal Chrome (session sync) and never logs in or asks for an OTP.
CREDIT_REPORT_MODE=ui
KW388_BASE_URL=https://admin.kr883.com

# Your normal Chrome must be started with --remote-debugging-port=9222 and keep a KR883 tab open,
# so the session can be read (read-only) and mirrored into the dedicated profile.
KW388_CDP_URL=http://127.0.0.1:9222
KW388_CHROME_PROFILE=Profile 1

# Pause (seconds) between customers in a scrape and between Members-page scrape pages. 0 = none.
KW_HUMAN_DELAY_MIN=0
KW_HUMAN_DELAY_MAX=0

# Optional: close the dedicated browser after this many idle seconds (default 600).
# KW388_UI_IDLE_CLOSE_S=600
# Optional: show the browser while debugging (default true = hidden).
# KW388_UI_HEADLESS=true

# ---- Web panel logins (HTTP form login on the service itself) -------------------------------
# Format user:password. Worker = Credit Report page only. Admin = everything.
# Choose strong values - the service can be exposed publicly through ngrok.
KW388_WORKER_AUTH=
KW388_ADMIN_AUTH=

# ---- Output / backend -----------------------------------------------------------------------
# LOCAL_ONLY=true writes results as JSON under data/output and posts nothing anywhere.
# Leave the BACKEND_ADMIN_* values blank to stay local.
LOCAL_ONLY=true
BACKEND_ADMIN_USERNAME=
BACKEND_ADMIN_PASSWORD=
BACKEND_ADMIN_PIN=
API_INTERNAL_URL=

# Local timezone used for day boundaries ("today", overdue windows).
TZ=Asia/Kuala_Lumpur

# ---- Google Sheets export (optional) --------------------------------------------------------
GOOGLE_SHEETS_AUTO_EXPORT=false
GOOGLE_SHEETS_TAB_PATTERN=KW388 %d/%m
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service-account key file: google-credentials.json (git-ignored, share the sheet with its email).

# ---- ngrok (optional public link) -----------------------------------------------------------
# Your reserved domain, e.g. https://your-name.ngrok.app. Leave blank for no watchdog.
# Add your token once with:  tools\bin\ngrok.exe config add-authtoken <token>
NGROK_DOMAIN=

# ---- Audit log ------------------------------------------------------------------------------
# data/logs/credit_report_access.log (rotated). Optional overrides:
# CREDIT_AUDIT_MAX_BYTES=2000000
# CREDIT_AUDIT_BACKUPS=5

# Auto-scrape schedule (MYT, e.g. 09:00,15:00). Empty = no scheduled scrapes.
KW388_SCHEDULE=
